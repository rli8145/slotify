# Copy to .env and fill in. Read by docker-compose (env_file) and by
# `dotenv/config` when running the backend/worker directly with npm.

ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Optional, only needed for /api/related-products
SERPAPI_KEY=

# Only used outside Docker (docker-compose sets these itself):
# REDIS_URL=redis://localhost:6379
# JOB_STORAGE_DIR=/tmp
